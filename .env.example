# CYMATIC Environment Configuration
# Copy this file to .env and fill in your values
#
# FAIL FAST: every CHANGEME_* placeholder below MUST be replaced with a strong,
# randomly generated value before first boot. The API/worker/router refuse to
# start in production with default/placeholder secrets (see
# services/*/app/core/config.py validators + lifespan checks), and an empty
# JWT_SECRET_KEY always fails startup. Generate with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# For production, set all *_PASSWORD and JWT_SECRET_KEY to non-default strong values.

# Release version for Docker image tags (compose + bake). `latest` = floating;
# set e.g. APP_VERSION=0.1.0 to pin `cymatic/<svc>:0.1.0` for a release.
APP_VERSION=latest

# =============================================================================
# Core Infrastructure
# =============================================================================

# PostgreSQL — keep total pooled connections < max_connections (100)
# DATABASE_URL for host-local dev uses localhost; Docker compose overrides to postgres:5432
# NOTE: the password below is a placeholder that MUST be replaced (see header).
# Production boots fail fast on default/empty POSTGRES_PASSWORD.
DATABASE_URL=postgresql://cymatic:CHANGEME_POSTGRES_PASSWORD@localhost:5432/cymatic
POSTGRES_USER=cymatic
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=cymatic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
# REQUIRED in production: POSTGRES_PASSWORD must be non-empty and not a default/placeholder.

# Redis — DB split: 0 queue, 1 cache, 2 usage, 3 rate, 4 revoked, 5 pubsub, 6 test
# Each service uses isolated DB via REDIS_* env (see docker-compose.yml)
# REDIS_URL is the job-queue connection (must be DB 0, same as worker).
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_USAGE_URL=redis://localhost:6379/2
REDIS_RATE_URL=redis://localhost:6379/3
REDIS_REVOKED_URL=redis://localhost:6379/4
REDIS_PUBSUB_URL=redis://localhost:6379/5
# NOTE: placeholder that MUST be replaced (see header). Production boots fail
# fast on default/empty REDIS_PASSWORD.
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD
REDIS_PORT=6379
# REQUIRED in production: REDIS_PASSWORD must be non-empty and not a default/placeholder.

# MinIO (S3-compatible object storage)
# NOTE: placeholders that MUST be replaced (see header). MinIO requires user
# >=3 chars and password >=8 chars; production boots fail fast on defaults.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGEME_MINIO_ROOT_USER
S3_SECRET_KEY=CHANGEME_MINIO_ROOT_PASSWORD
S3_BUCKET_NAME=cymatic
S3_REGION=us-east-1
MINIO_ROOT_USER=CHANGEME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_ROOT_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# REQUIRED in production: MINIO_ROOT_PASSWORD must be non-empty and not a default/placeholder.

# =============================================================================
# Backend API
# =============================================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# JWT Authentication — must be >=32 chars, not default in production
# REQUIRED in production: JWT_SECRET_KEY MUST be set to a strong random value
# (>=32 chars). It is intentionally left EMPTY here so startup FAILS FAST
# instead of running with an insecure default — generate one (see header) and
# never commit the real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the API (web builder + mobile viewer)
CORS_ORIGINS=http://localhost:3000,http://localhost:8090

# =============================================================================
# LLM Router
# =============================================================================

LLM_ROUTER_URL=http://localhost:8001
LLM_ROUTER_HOST=0.0.0.0
LLM_ROUTER_PORT=8001

# Provider API Keys (fill in your keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
APINEX_API_KEY=
APINEX_BASE_URL=https://api.apinex.bond/v1
# REQUIRED in production: ADMIN_API_KEY must be set to a strong random value.
# Left EMPTY here so startup fails fast instead of running unauthenticated.
ADMIN_API_KEY=
# Data-plane key for LLM inference routes (/v1/chat, /v1/embeddings, /v1/audio/*).
# Empty = fall back to ADMIN_API_KEY (back-compat; a warning is logged).
LLM_API_KEY=

# Default Model Configuration
DEFAULT_FAST_MODEL=llama-3.1-8b-instant
DEFAULT_STRONG_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_STT_PROVIDER=sarvam
DEFAULT_TTS_PROVIDER=sarvam

# Planning models (Qwen via Groq primary, OpenRouter fallback)
QWEN_GROQ_MODEL=qwen-qwq-32b
QWEN_OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Offline <3B SLM via Ollama sidecar (feature-flagged, default off for cloud CI).
# LAN quickstart (Windows/PowerShell):
#   docker compose -f infra/docker/docker-compose.yml --profile local up -d ollama
#   docker exec <ollama-container> ollama pull phi3:mini
# then set ENABLE_LOCAL_LLM=true (already true in .env for local dev).
# Without ollama AND without GROQ/OPENROUTER keys, /health returns a hint and
# spec generation falls back to deterministic templates (see /health).
# 8GB RAM CPU-only box: phi-3-mini q4 (~2.3GB).
ENABLE_LOCAL_LLM=false
OLLAMA_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=phi-3-mini-3.8b-q4
LOCAL_LLM_CONTEXT=4096

# =============================================================================
# Worker Service
# =============================================================================

WORKER_CONCURRENCY=4
WORKER_QUEUES=generation,spec,asset,analytics
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_PORT=8002

# =============================================================================
# Streaming / Unity Render Server
# =============================================================================

# Render Server (runs natively on Windows gaming laptop)
RENDER_SERVER_URL=http://<GAMING_LAPTOP_IP>:8080
RENDER_SERVER_WS_URL=ws://<GAMING_LAPTOP_IP>:8080/ws

# Signaling (WebRTC)
SIGNALING_URL=ws://localhost:8000/v1/stream
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
TURN_REALM=cymatic.local
COTURN_PORT=3478
COTURN_TLS_PORT=5349

# =============================================================================
# Frontend (Next.js)
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
API_INTERNAL_URL=http://api:8000
WEB_PORT=3000

# =============================================================================
# Mobile Browser Viewer (Vite + Three.js walkthrough client)
# =============================================================================

VIEWER_HOST=0.0.0.0
VIEWER_PORT=8090
VITE_API_URL=http://localhost:8000

# =============================================================================
# Feature Flags
# =============================================================================

ENABLE_HAND_TRACKING=false
ENABLE_UVC_CAMERA=false
ENABLE_VOICE=true
ENABLE_HERITAGE_TEMPLATES=true
ENABLE_ADAPTIVE_STREAMING=true
ENABLE_MANUAL_EDITING=false
ENABLE_MULTIPLAYER=false

# =============================================================================
# Logging & Monitoring
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# =============================================================================
# Development / Testing
# =============================================================================

# Production-safe example values: DEBUG stays off and ENVIRONMENT defaults to
# production so a copied example never silently runs an insecure dev profile.
# Local development: override to ENVIRONMENT=development and DEBUG=true in
# your private .env. CI integration tests override ENVIRONMENT=development
# explicitly (Secure auth cookies require non-production over plain HTTP).
ENVIRONMENT=production
DEBUG=false
TEST_DATABASE_URL=postgresql://cymatic:CHANGEME_POSTGRES_PASSWORD@localhost:5432/cymatic_test
