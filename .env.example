# CYMATIC Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Core Infrastructure
# =============================================================================

# PostgreSQL
DATABASE_URL=postgresql://cymatic:cymatic@localhost:5432/cymatic
POSTGRES_USER=cymatic
POSTGRES_PASSWORD=cymatic
POSTGRES_DB=cymatic

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=cymatic
S3_REGION=us-east-1

# =============================================================================
# Backend API
# =============================================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# JWT Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# LLM Router
# =============================================================================

LLM_ROUTER_URL=http://localhost:8001
LLM_ROUTER_HOST=0.0.0.0
LLM_ROUTER_PORT=8001

# Provider API Keys (fill in your keys)
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
ADMIN_API_KEY=

# Default Model Configuration
DEFAULT_FAST_MODEL=llama-3.1-8b-instant
DEFAULT_STRONG_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_STT_PROVIDER=sarvam
DEFAULT_TTS_PROVIDER=sarvam

# =============================================================================
# Worker Service
# =============================================================================

WORKER_CONCURRENCY=4
WORKER_QUEUES=generation,spec,asset,analytics
WORKER_JOB_TIMEOUT_SECONDS=300

# =============================================================================
# Streaming / Unity Render Server
# =============================================================================

# Render Server (runs natively on Windows gaming laptop)
RENDER_SERVER_URL=http://<GAMING_LAPTOP_IP>:8080
RENDER_SERVER_WS_URL=ws://<GAMING_LAPTOP_IP>:8080/ws

# Signaling (WebRTC)
SIGNALING_URL=ws://localhost:8000/v1/stream
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# =============================================================================
# Frontend (Next.js)
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MINIO_URL=http://localhost:9000

# =============================================================================
# Feature Flags
# =============================================================================

ENABLE_HAND_TRACKING=false
ENABLE_UVC_CAMERA=false
ENABLE_VOICE=true
ENABLE_HERITAGE_TEMPLATES=true
ENABLE_ADAPTIVE_STREAMING=true
ENABLE_MANUAL_EDITING=false
ENABLE_MULTIPLAYER=false

# =============================================================================
# Logging & Monitoring
# =============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# =============================================================================
# Development / Testing
# =============================================================================

ENVIRONMENT=development
DEBUG=true
TEST_DATABASE_URL=postgresql://cymatic:cymatic@localhost:5432/cymatic_test
