<resources>
    <!-- Base theme -->
    <style name="Theme.CymaticClient" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/error</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>

    <!-- Fullscreen theme for VR -->
    <style name="Theme.CymaticClient.Fullscreen" parent="Theme.CymaticClient">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="Theme.CymaticClient.Fullscreen.NoActionBar" parent="Theme.CymaticClient.Fullscreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.CymaticClient.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.CymaticClient.Button.Secondary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.CymaticClient.Button.Icon" parent="Widget.Material3.Button.Icon">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">50%</item>
    </style>

    <!-- Card styles -->
    <style name="Widget.CymaticClient.Card" parent="Widget.Material3.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/surface_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.CymaticClient.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CymaticClient.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.CymaticClient.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/gray_light</item>
    </style>

    <style name="TextAppearance.CymaticClient.Mono" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/roboto_mono</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
